# Copy to .env.local for local development. These credentials are local-only.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://way2we:local-development-only@127.0.0.1:55432/way2we_dev?sslmode=disable
DEV_DIAGNOSTICS=true
APP_VERSION=development
AUTH_SECRET_FILE=.secrets/auth.key
MAILPIT_SMTP_ADDR=127.0.0.1:1025
# Per-hour email sends; verification attempts per source use a 10-minute window.
AUTH_SEND_PER_EMAIL=5
AUTH_SEND_PER_SOURCE=20
AUTH_VERIFY_PER_SOURCE=60
